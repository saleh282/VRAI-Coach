# Use the project's Node runtime inside the container.
FROM node:22

# Keep application files isolated from the container root.
WORKDIR /app

# Install exactly the dependencies recorded in package-lock.json.
COPY package*.json ./

RUN npm ci --omit=dev

# Copy backend source and runtime configuration files into the image.
COPY . .

# The API listens on this port by default.
EXPOSE 5000

CMD ["node", "server.js"]
