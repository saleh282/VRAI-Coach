PORT=5000
MONGO_URI=mongodb+srv://<database-user>:<url-encoded-password>@<cluster-host>/vrai-coach?retryWrites=true&w=majority
JWT_SECRET=<replace-with-a-long-random-secret>
# Access tokens are short-lived; clients renew them with POST /api/v1/auth/refresh.
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
AI_SERVICE_API_KEY=replace-with-a-long-random-secret

# Email for verification and password-reset codes (OTP).
# Leave SMTP_* empty in development: codes are printed in the server console instead.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<gmail address>,
# SMTP_PASS=<16-character Google App Password, not your normal password>.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="VRAI Coach <no-reply@example.com>"
OTP_TTL_MINUTES=10

# Google sign-in: the OAuth client IDs allowed to sign in (web, Android, iOS), comma-separated.
GOOGLE_CLIENT_ID=1009601844364-t63b99u6kjd0jd4f5jfja2um1t9m3hdi.apps.googleusercontent.com

# Set to 1 when the API runs behind a reverse proxy, so rate limits see real client IPs.
TRUST_PROXY=
